{
  "openapi": "3.0.0",
  "info": {
    "title": "MakeUP By Mercy API",
    "description": "REST API for the MakeUP By Mercy booking management system: public booking submission and lookup, and a JWT-protected admin console covering bookings, pricing, email templates, analytics, and admin user management.\n\n### Authentication\nAdmin endpoints require a JWT obtained from `POST /api/admin/login`, sent as `Authorization: Bearer <token>`. Tokens expire after 24 hours.\n\n### Roles\n`admin` (full access, including user management), `manager`, and `viewer`. Endpoints marked \"admin only\" require the `admin` role regardless of a valid token.\n\n### Storage modes\nWhen `MONGODB_URI` is not configured, the server falls back to an in-memory store (development default, default credentials `admin` / `admin123`). Endpoints under Admin Pricing, Admin Email Templates, and Admin Users require a connected database and return `400` in-memory.\n\n### Rate limits\n- General API: 100 requests / 15 minutes per IP\n- Admin login: 5 attempts / 15 minutes per IP\n- Public booking submission: 10 requests / hour per IP",
    "version": "1.1.0",
    "contact": {
      "name": "MakeUP By Mercy Support",
      "email": "support@makeup-mercy.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Development server"
    },
    {
      "url": "https://makeup-by-mercy.onrender.com",
      "description": "Production server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT issued by POST /api/admin/login, valid for 24 hours."
      }
    },
    "schemas": {
      "Booking": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Numeric booking ID (in-memory storage mode)"
          },
          "_id": {
            "type": "string",
            "description": "MongoDB document ID (database storage mode)"
          },
          "bookingNumber": {
            "type": "string",
            "example": "MKP-01001",
            "description": "Unique, sequential booking reference in the form MKP-#####"
          },
          "name": {
            "type": "string",
            "description": "Customer name"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Customer email address"
          },
          "phone": {
            "type": "string",
            "description": "Customer phone number"
          },
          "country": {
            "type": "string",
            "default": "Nigeria",
            "description": "Customer country"
          },
          "service": {
            "type": "string",
            "enum": ["bridal", "party", "casual"],
            "description": "Makeup service type"
          },
          "date": {
            "type": "string",
            "format": "date-time",
            "description": "Appointment date and time (must be in the future at creation time)"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "confirmed", "completed", "cancelled"],
            "default": "confirmed",
            "description": "Booking status"
          },
          "bookedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the booking was created"
          },
          "qrCode": {
            "type": "string",
            "nullable": true,
            "description": "Base64-encoded QR code data URI for the booking receipt"
          }
        }
      },
      "BookingInput": {
        "type": "object",
        "required": ["name", "email", "phone", "service", "date"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "example": "Ada Okafor"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string",
            "description": "10-20 characters; digits, spaces, +, -, ( ) only",
            "example": "+234 801 234 5678"
          },
          "country": {
            "type": "string",
            "maxLength": 50,
            "default": "Nigeria"
          },
          "service": {
            "type": "string",
            "enum": ["bridal", "party", "casual"]
          },
          "date": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 date-time; must be now or in the future"
          }
        }
      },
      "Admin": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": ["admin", "manager", "viewer"],
            "description": "Admin role determining permission level"
          },
          "active": {
            "type": "boolean"
          },
          "lastLogin": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AdminUserInput": {
        "type": "object",
        "required": ["username", "email", "password"],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 30,
            "pattern": "^[a-zA-Z0-9]+$",
            "description": "Alphanumeric only"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 100,
            "description": "Must contain at least one uppercase letter, one digit, and one of !@#$%^&*"
          },
          "role": {
            "type": "string",
            "enum": ["admin", "manager", "viewer"],
            "default": "manager"
          }
        }
      },
      "Pricing": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "service": {
            "type": "string",
            "enum": ["bridal", "party", "casual"]
          },
          "minPrice": {
            "type": "number",
            "description": "Minimum price in Naira"
          },
          "maxPrice": {
            "type": "number",
            "description": "Maximum price in Naira"
          },
          "description": {
            "type": "string"
          },
          "updatedBy": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PricingInput": {
        "type": "object",
        "required": ["minPrice", "maxPrice"],
        "properties": {
          "minPrice": {
            "type": "number",
            "minimum": 0
          },
          "maxPrice": {
            "type": "number",
            "minimum": 0,
            "description": "Must be greater than or equal to minPrice"
          },
          "description": {
            "type": "string",
            "maxLength": 500
          }
        }
      },
      "EmailTemplate": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["confirmation", "reminder", "cancellation", "custom"],
            "description": "Template type"
          },
          "subject": {
            "type": "string",
            "description": "Email subject (5-200 chars)"
          },
          "body": {
            "type": "string",
            "description": "Email body template (20-5000 chars). Supports placeholders such as {bookingNumber}, {date}, {service}, {phone}, {country}"
          },
          "variables": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "updatedBy": {
            "type": "string",
            "description": "Username who last updated the template"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "EmailTemplateInput": {
        "type": "object",
        "required": ["subject", "body"],
        "properties": {
          "subject": {
            "type": "string",
            "minLength": 5,
            "maxLength": 200
          },
          "body": {
            "type": "string",
            "minLength": 20,
            "maxLength": 5000
          }
        }
      },
      "DashboardStats": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "totalBookings": {
            "type": "integer"
          },
          "confirmedBookings": {
            "type": "integer"
          },
          "pendingBookings": {
            "type": "integer"
          },
          "monthlyRevenue": {
            "type": "number",
            "description": "Sum of a fixed per-service price for bookings dated in the current calendar month"
          },
          "repeatCustomers": {
            "type": "integer",
            "description": "Count of customers (by email) with more than one booking"
          }
        }
      },
      "Analytics": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "serviceBreakdown": {
            "type": "object",
            "properties": {
              "bridal": {
                "type": "integer"
              },
              "party": {
                "type": "integer"
              },
              "casual": {
                "type": "integer"
              }
            }
          },
          "popularService": {
            "type": "string",
            "enum": ["bridal", "party", "casual"]
          }
        }
      },
      "SuccessMessage": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ValidationErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Validation error"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing, invalid, or expired JWT",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Forbidden": {
        "description": "Authenticated, but the admin's role does not permit this action",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "ValidationError": {
        "description": "Request body failed validation",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" }
          }
        }
      },
      "RateLimited": {
        "description": "Too many requests from this IP in the current window",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "ServerError": {
        "description": "Unexpected server error",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "DatabaseRequired": {
        "description": "This feature requires a connected MongoDB database and is unavailable in in-memory (development fallback) mode",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Health check",
        "description": "Unauthenticated liveness check.",
        "responses": {
          "200": {
            "description": "Server is running",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "Server is running" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/bookings": {
      "get": {
        "tags": ["Bookings"],
        "summary": "List bookings",
        "description": "Retrieve all bookings, optionally filtered by status and/or service. Public endpoint (no authentication).",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled"] }
          },
          {
            "name": "service",
            "in": "query",
            "schema": { "type": "string", "enum": ["bridal", "party", "casual"] }
          }
        ],
        "responses": {
          "200": {
            "description": "List of bookings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "bookings": { "type": "array", "items": { "$ref": "#/components/schemas/Booking" } }
                  }
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "post": {
        "tags": ["Bookings"],
        "summary": "Create a booking",
        "description": "Submit a new booking request. Sends confirmation emails to the customer and the business owner. Rate limited to 10 requests/hour per IP.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/BookingInput" } }
          }
        },
        "responses": {
          "201": {
            "description": "Booking created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "message": { "type": "string" },
                    "booking": { "$ref": "#/components/schemas/Booking" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/bookings/{id}": {
      "get": {
        "tags": ["Bookings"],
        "summary": "Get a booking by numeric ID",
        "description": "Public lookup by the internal numeric `id` (not the `bookingNumber`).",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Booking found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "booking": { "$ref": "#/components/schemas/Booking" }
                  }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "delete": {
        "tags": ["Bookings"],
        "summary": "Delete a booking",
        "description": "Permanently removes a booking by numeric `id`. Public endpoint — not admin-gated.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Booking deleted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SuccessMessage" } } } },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/bookings/{id}/receipt/pdf": {
      "get": {
        "tags": ["Bookings"],
        "summary": "Download booking receipt (PDF)",
        "description": "Generates and streams a PDF receipt. `id` here is the `bookingNumber` (format `MKP-#####`), despite the path segment name.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^MKP-\\d{5}$" }, "example": "MKP-01001" }
        ],
        "responses": {
          "200": {
            "description": "PDF file stream",
            "content": { "application/pdf": { "schema": { "type": "string", "format": "binary" } } }
          },
          "400": { "description": "Invalid booking ID format", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/bookings/{id}/receipt/image": {
      "get": {
        "tags": ["Bookings"],
        "summary": "Get booking receipt QR code",
        "description": "Returns a base64 QR code (encoding the booking number) plus the booking details, for rendering a receipt image client-side. `id` is the `bookingNumber`.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^MKP-\\d{5}$" }, "example": "MKP-01001" }
        ],
        "responses": {
          "200": {
            "description": "QR code and booking details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "qrCode": { "type": "string", "description": "Base64-encoded PNG data URI" },
                    "booking": { "$ref": "#/components/schemas/Booking" }
                  }
                }
              }
            }
          },
          "400": { "description": "Invalid booking ID format", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/admin/login": {
      "post": {
        "tags": ["Admin Authentication"],
        "summary": "Admin login",
        "description": "Authenticate and receive a JWT (24h expiry). Rate limited to 5 attempts/15 minutes per IP. In-memory mode accepts only `admin` / `admin123`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string", "minLength": 3, "maxLength": 30 },
                  "password": { "type": "string", "minLength": 8, "maxLength": 100 }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "token": { "type": "string", "description": "JWT, valid for 24 hours" },
                    "username": { "type": "string" },
                    "role": { "type": "string", "enum": ["admin", "manager", "viewer"] }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "description": "Invalid credentials", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/admin/dashboard": {
      "get": {
        "tags": ["Admin Dashboard"],
        "summary": "Dashboard statistics",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Dashboard statistics",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DashboardStats" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/admin/bookings": {
      "get": {
        "tags": ["Admin Bookings"],
        "summary": "List all bookings (admin)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "All bookings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "bookings": { "type": "array", "items": { "$ref": "#/components/schemas/Booking" } }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/admin/bookings/recent": {
      "get": {
        "tags": ["Admin Bookings"],
        "summary": "List recent bookings",
        "description": "Most recently created bookings, newest first (used by the dashboard's Recent Bookings widget).",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Recent bookings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "bookings": { "type": "array", "items": { "$ref": "#/components/schemas/Booking" } }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/admin/appointments/upcoming": {
      "get": {
        "tags": ["Admin Bookings"],
        "summary": "List upcoming appointments",
        "description": "Non-cancelled bookings dated within the next 7 days, soonest first, capped at 10.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Upcoming appointments",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "appointments": { "type": "array", "items": { "$ref": "#/components/schemas/Booking" } }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/admin/bookings/{id}/confirm": {
      "patch": {
        "tags": ["Admin Bookings"],
        "summary": "Confirm a booking",
        "description": "Sets status to `confirmed`. `id` is the booking's `id`/`_id` (not `bookingNumber`).",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Booking confirmed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "booking": { "$ref": "#/components/schemas/Booking" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/admin/bookings/{id}/cancel": {
      "patch": {
        "tags": ["Admin Bookings"],
        "summary": "Cancel a booking",
        "description": "Sets status to `cancelled`. `id` is the booking's `id`/`_id` (not `bookingNumber`).",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Booking cancelled",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "booking": { "$ref": "#/components/schemas/Booking" }
                  }
                }
              }
            }
          },
