            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "subject": {
                    "type": "string",
                    "minLength": 5,
                    "maxLength": 200
                  },
                  "body": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 5000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Template partially updated"
          },
          "400": {
