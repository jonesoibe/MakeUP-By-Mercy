{
  "openapi": "3.0.0",
  "info": {
    "title": "MakeUP By Mercy API",
    "description": "Comprehensive API documentation for the MakeUP By Mercy booking management system",
    "version": "1.0.0",
    "contact": {
      "name": "MakeUP By Mercy Support",
      "email": "support@makeup-mercy.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Development server"
    },
    {
      "url": "https://makeup-by-mercy.onrender.com",
      "description": "Production server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT token for admin authentication"
      }
    },
    "schemas": {
      "Booking": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "description": "Unique booking ID"
          },
          "bookingNumber": {
            "type": "string",
            "description": "Unique booking reference number"
          },
          "name": {
            "type": "string",
            "description": "Customer name"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Customer email address"
          },
          "phone": {
            "type": "string",
            "description": "Customer phone number"
          },
          "country": {
            "type": "string",
            "description": "Customer country"
          },
          "service": {
            "type": "string",
            "enum": ["bridal", "party", "casual"],
            "description": "Makeup service type"
          },
          "date": {
            "type": "string",
            "format": "date-time",
            "description": "Appointment date and time"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "confirmed", "completed", "cancelled"],
            "description": "Booking status"
          },
          "bookedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the booking was created"
          }
        }
      },
      "Admin": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": ["admin", "manager", "viewer"],
            "description": "Admin role"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Pricing": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "service": {
            "type": "string",
            "enum": ["bridal", "party", "casual"]
          },
          "minPrice": {
            "type": "number",
            "description": "Minimum price in Naira"
          },
          "maxPrice": {
            "type": "number",
            "description": "Maximum price in Naira"
          },
          "description": {
            "type": "string"
          },
          "duration": {
            "type": "string"
          }
        }
      },
      "EmailTemplate": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["confirmation", "reminder", "cancellation"],
            "description": "Template type"
          },
          "subject": {
            "type": "string",
            "description": "Email subject (5-200 chars)"
          },
          "body": {
            "type": "string",
            "description": "Email body template (20-5000 chars)"
          },
          "variables": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Template variables like {bookingNumber}, {date}, {service}"
          },
          "updatedBy": {
            "type": "string",
            "description": "Username who last updated the template"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DashboardStats": {
        "type": "object",
        "properties": {
          "totalBookings": {
            "type": "integer"
          },
          "confirmedBookings": {
            "type": "integer"
          },
          "monthlyRevenue": {
            "type": "number"
          },
          "repeatCustomers": {
            "type": "integer"
          },
          "appointments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Booking"
            }
          }
        }
      },
      "Analytics": {
        "type": "object",
        "properties": {
          "serviceBreakdown": {
            "type": "object",
            "properties": {
              "bridal": {
                "type": "integer"
              },
              "party": {
                "type": "integer"
              },
              "casual": {
                "type": "integer"
              }
            }
          },
          "totalRevenue": {
            "type": "number"
          },
          "conversionRate": {
            "type": "number"
          }
        }
      }
    }
  },
  "paths": {
    "/api/bookings": {
      "get": {
        "tags": ["Bookings"],
        "summary": "Get all bookings",
        "description": "Retrieve all bookings with optional filtering",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["pending", "confirmed", "completed", "cancelled"]
            }
          },
          {
            "name": "service",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["bridal", "party", "casual"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of bookings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "bookings": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Booking"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Bookings"],
        "summary": "Create a new booking",
        "description": "Submit a new makeup booking request",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "phone", "service", "date"],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 100
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "country": {
                    "type": "string"
                  },
                  "service": {
                    "type": "string",
                    "enum": ["bridal", "party", "casual"]
                  },
                  "date": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Appointment date (must be in future)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Booking created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "booking": {
                      "$ref": "#/components/schemas/Booking"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid booking data"
          },
          "429": {
            "description": "Too many booking requests (rate limited)"
          }
        }
      }
    },
    "/api/bookings/{id}": {
      "get": {
        "tags": ["Bookings"],
        "summary": "Get booking details",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Booking details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "booking": {
                      "$ref": "#/components/schemas/Booking"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Booking not found"
          }
        }
      },
      "delete": {
        "tags": ["Bookings"],
        "summary": "Cancel a booking",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Booking cancelled successfully"
          },
          "404": {
            "description": "Booking not found"
          }
        }
      }
    },
    "/api/admin/login": {
      "post": {
        "tags": ["Admin Authentication"],
        "summary": "Admin login",
        "description": "Authenticate admin user and get JWT token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "token": {
                      "type": "string",
                      "description": "JWT token (valid for 24 hours)"
                    },
                    "username": {
                      "type": "string"
                    },
                    "role": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          },
          "429": {
            "description": "Too many login attempts"
          }
        }
      }
    },
    "/api/admin/dashboard": {
      "get": {
