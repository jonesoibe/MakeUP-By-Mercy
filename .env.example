# Server Configuration
PORT=3000
NODE_ENV=production

# Email. SendGrid is tried first; if it is not configured or a send fails,
# the app falls back to Gmail. Gmail needs 2-Step Verification on the account and a
# 16-character App Password (Google Account > Security > App passwords) - not the
# normal Gmail password.
# SENDGRID_API_KEY=your-sendgrid-api-key
# SENDGRID_FROM_EMAIL=verified-sender@example.com
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-char-app-password

# Owner Email (Receives booking notifications)
OWNER_EMAIL=owner@example.com

# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# API Configuration
REACT_APP_API_URL=http://localhost:3000

# JWT Configuration - CHANGE THIS IN PRODUCTION!
# Generate strong secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secure-64-character-random-string-here

# Optional: Client URL for CORS whitelist (if different from deployment domain)
# CLIENT_URL=https://your-frontend-domain.com

# Local development only: enables admin login without a database.
# Ignored when NODE_ENV=production or MONGODB_URI is set.
# DEV_ADMIN_PASSWORD=choose-a-local-password

# First admin account. The server no longer seeds a built-in password.
# Set this (12+ characters) and restart to create the "admin" user, or to
# reset an account that still uses the old default password.
# ADMIN_INITIAL_PASSWORD=choose-a-long-unique-password
# Number of reverse-proxy hops to trust for client IPs (defaults to 1 in production).
# TRUST_PROXY=1
