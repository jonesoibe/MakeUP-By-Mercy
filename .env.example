# Server Configuration
PORT=3000
NODE_ENV=development

# ========== SECURITY: JWT Configuration ==========
# IMPORTANT: Set a strong random secret for production!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This MUST be unique and at least 32 bytes (64 hex characters)
JWT_SECRET=your-very-long-random-secret-here-change-in-production

# ========== SECURITY: Initial Admin Setup ==========
# For production deployment, set this to a strong random password
# or handle admin creation through secure setup endpoint
# If not set in development, a temporary password will be generated and logged
# INITIAL_ADMIN_PASSWORD=your-strong-admin-password-here

# Email Configuration (Gmail, Outlook, etc.)
# Fixed to use TLS on port 587 for reliable connection
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Owner/Business Email (for booking notifications)
# If not set, will use EMAIL_USER by default
OWNER_EMAIL=mercy-email@gmail.com

# MongoDB Atlas Cloud Configuration (Optional)
# Sign up at https://www.mongodb.com/cloud/atlas
# Connection string format:
# mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/makeup_mercy?retryWrites=true&w=majority
MONGODB_URI=

# For Gmail:
# 1. Enable 2-Factor Authentication on your Google Account
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character password here

# For Outlook/Hotmail:
# EMAIL_SERVICE=outlook
# EMAIL_USER=your-email@outlook.com
# EMAIL_PASSWORD=your-password

# ========== SECURITY: CORS Configuration ==========
# Allowed origins are configured in server.js
# Add your domain to the allowedOrigins array for production

# Client Configuration
REACT_APP_API_URL=http://localhost:3000
